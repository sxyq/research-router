{
  "version": 1,
  "policy": {
    "default_auth": "none",
    "default_output": "compact-json",
    "default_evidence_level": "discovery",
    "raw_pages": "read-only-after-selection"
  },
  "components": [
    {
      "id": "exa-mcp",
      "display_name": "Exa MCP search",
      "kind": "external-mcp",
      "source": "https://docs.exa.ai/reference/exa-mcp",
      "requires_api_key": false,
      "status": "optional-runtime",
      "platforms": [],
      "providers": ["exa"],
      "output": ["title", "url", "excerpt", "published_at", "source"],
      "limits": ["Requires an available Exa MCP configuration", "Not a platform entry", "Use only after the selected platform and access conditions are known"]
    },
    {
      "id": "github-public-multipath",
      "display_name": "Bundled GitHub Multi-Path Retrieval",
      "kind": "local-platform-adapter",
      "source": "local:scripts/github_public.py",
      "requires_api_key": false,
      "status": "bundled",
      "platforms": ["github"],
      "providers": ["repository-search", "gh-repository-search", "generic-web-discovery", "metadata", "readme", "tree", "snapshot", "local-tree", "local-file", "local-find", "raw-file", "archive-fallback", "issues", "releases", "commits", "cleanup"],
      "output": ["title", "url", "description", "metadata", "retrieval_method", "snapshot_root", "api_budget", "source", "tests", "dependencies", "issues", "releases", "commits"],
      "limits": ["REST is anonymous by default; configured GITHUB_TOKEN or GH_TOKEN is optional", "Use REST primarily for repository search, structured metadata, tree metadata, Issues, Releases, and commits", "The repo command uses REST README Contents as a light-read shortcut; prefer source snapshot or selected-file provenance when needed", "Prefer a route snapshot, shallow snapshot, official archive, or known-path raw file before REST Contents for source analysis", "REST Contents is a selected-file fallback, not a bulk source reader; responses are capped at 8 MB and file text at 40,000 characters", "Archive snapshots are capped at 64 MB compressed, 256 MB extracted, 20,000 files, and 8 MB per file; raw files are capped at 8 MB", "Git shallow clone is skipped above the reported 512000 KiB repository-size limit and omits blobs above 8 MB", "Tree output is limited to 5,000 entries and may be marked truncated", "Anonymous GitHub API quotas apply; an already-installed gh is optional", "Private repositories are not accessible without authorized access"]
    },
    {
      "id": "academic-public-evidence",
      "display_name": "Bundled Academic Public Metadata and HTML Reader",
      "kind": "local-platform-adapter",
      "source": "local:academic-evidence/scripts/academic_public.py",
      "requires_api_key": false,
      "status": "bundled",
      "platforms": ["academic", "google-scholar"],
      "providers": ["crossref-metadata", "arxiv-metadata", "public-html-paper-reading"],
      "output": ["title", "authors", "venue", "published_at", "abstract", "headings", "selected_passages", "pdf_url"],
      "limits": ["HTML full text only when the publisher or repository exposes it publicly", "PDF text extraction uses pypdf only if already installed"]
    },
    {
      "id": "generic-public-site-discovery",
      "display_name": "Bundled Domain-Constrained Public Web Discovery",
      "kind": "local-generic-discovery",
      "source": "local:scripts/platform_discovery.py",
      "requires_api_key": false,
      "status": "bundled-bounded",
      "platforms": ["bilibili", "douyin", "tiktok", "xiaohongshu", "linux-do", "v2ex", "github", "academic", "google-scholar", "stackoverflow", "52pojie", "discourse", "youtube", "twitter-x", "xueqiu", "hacker-news", "dev-to", "lobsters", "reddit", "zhihu", "wikipedia", "bbc", "weibo", "douban", "weread", "boss-zhipin", "facebook", "instagram", "jike", "google", "bloomberg", "medium", "substack", "linkedin", "yahoo-finance", "cursor", "notion", "chatgpt", "discord", "codex"],
      "providers": ["public-site-constrained-search", "stackoverflow", "discourse"],
      "output": ["title", "url", "excerpt", "published_at", "source", "platform_id", "evidence_level"],
      "limits": ["Public candidate discovery only", "HTML search endpoint may block or rate-limit", "No authenticated or hidden content"]
    },
    {
      "id": "bilibili-public-api",
      "display_name": "Bilibili public video search API",
      "kind": "local-platform-adapter",
      "source": "local:scripts/bilibili_public.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["bilibili"],
      "providers": ["bilibili-public"],
      "output": ["title", "url", "excerpt", "published_at", "author", "duration", "play_count"],
      "limits": ["Discovery only", "Bilibili may return anti-abuse or unavailable responses", "Video detail and subtitles use a separate external route"]
    },
    {
      "id": "v2ex-public-api",
      "display_name": "V2EX public JSON API",
      "kind": "local-platform-adapter",
      "source": "local:scripts/v2ex_public.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["v2ex"],
      "providers": ["v2ex-public"],
      "output": ["topic", "reply", "user", "url", "excerpt", "created"],
      "limits": ["Supports hot, node, topic, replies, and user endpoints", "No official full-text keyword search endpoint"]
    },
    {
      "id": "xueqiu-public-api",
      "display_name": "Xueqiu public HTTP endpoints",
      "kind": "local-platform-adapter",
      "source": "local:scripts/xueqiu_public.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["xueqiu"],
      "providers": ["xueqiu-public"],
      "output": ["symbol", "name", "quote", "post", "url", "rank"],
      "limits": ["Public endpoints may require a session under current anti-abuse rules", "No browser cookies are read"]
    },
    {
      "id": "youtube-yt-dlp",
      "display_name": "yt-dlp YouTube adapter",
      "kind": "external-cli",
      "source": "https://github.com/yt-dlp/yt-dlp",
      "requires_api_key": false,
      "status": "optional-runtime",
      "platforms": ["youtube"],
      "providers": ["yt-dlp"],
      "output": ["title", "url", "metadata", "subtitle"],
      "limits": ["Requires yt-dlp at runtime", "Subtitle availability varies by video", "Transcription is an explicit extra step"]
    },
    {
      "id": "fast-search",
      "display_name": "Fast Search public adapters",
      "kind": "local-script",
      "source": "local:scripts/fast_search.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["github", "stackoverflow", "hacker-news", "dev-to", "wikipedia", "academic", "discourse"],
      "providers": ["github", "stackoverflow", "hacker-news", "dev-to", "wikipedia", "openalex", "semantic-scholar", "pubmed", "serpapi-scholar", "crossref", "arxiv", "google-scholar", "discourse", "rss"],
      "output": ["title", "url", "published_at", "excerpt", "source", "match_reason", "evidence_level"],
      "limits": ["Public endpoints can rate-limit or change without notice", "Results are discovery evidence until the selected source is read", "SerpApi is selected explicitly and requires its account key; anonymous providers remain available"]
    },
    {
      "id": "ddgs",
      "display_name": "DuckDuckGo Search Python package",
      "kind": "optional-python-package",
      "source": "https://pypi.org/project/ddgs/",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["bilibili", "douyin", "tiktok", "xiaohongshu", "reddit", "zhihu", "bbc", "twitter-x", "youtube", "weibo", "douban", "medium", "substack", "linkedin", "yahoo-finance", "google"],
      "providers": ["ddgs"],
      "output": ["title", "url", "excerpt", "date"],
      "limits": ["Requires the optional ddgs package", "Underlying engines may vary in availability and ranking", "Use for discovery rather than source-level claims"]
    },
    {
      "id": "searxng-json",
      "display_name": "SearXNG JSON search",
      "kind": "public-http-api",
      "source": "https://docs.searxng.org/dev/search_api.html",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["google", "hacker-news", "dev-to", "lobsters", "reddit", "zhihu", "bbc", "twitter-x", "youtube", "weibo", "douban", "medium", "substack", "linkedin", "yahoo-finance"],
      "providers": ["searxng"],
      "output": ["title", "url", "excerpt", "engine"],
      "limits": ["A public instance must allow JSON output", "Instance latency, certificate state, and rate limits vary", "Do not treat one public instance as a stable dependency"]
    },
    {
      "id": "github-search-api",
      "display_name": "GitHub REST Search API",
      "kind": "public-http-api",
      "source": "https://docs.github.com/en/rest/search/search",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["github"],
      "providers": ["github"],
      "output": ["repository", "url", "description", "updated_at", "stars"],
      "limits": ["Anonymous search is rate limited", "Source claims still require repository tree and file reading"]
    },
    {
      "id": "stackexchange-api",
      "display_name": "Stack Exchange API",
      "kind": "public-http-api",
      "source": "https://api.stackexchange.com/docs/search-advanced",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["stackoverflow"],
      "providers": ["stackoverflow"],
      "output": ["title", "url", "tags", "answer_count", "is_answered", "last_activity"],
      "limits": ["Respect quota and backoff fields", "Answers remain community evidence and need context reading"]
    },
    {
      "id": "hn-algolia",
      "display_name": "Hacker News Algolia API",
      "kind": "public-http-api",
      "source": "https://hn.algolia.com/api",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["hacker-news"],
      "providers": ["hacker-news"],
      "output": ["title", "url", "excerpt", "created_at"],
      "limits": ["Search results are discovery evidence; read the linked story or thread for claims"]
    },
    {
      "id": "devto-api",
      "display_name": "Dev.to / Forem API",
      "kind": "public-http-api",
      "source": "https://developers.forem.com/api",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["dev-to"],
      "providers": ["dev-to"],
      "output": ["title", "url", "description", "published_at"],
      "limits": ["The public endpoint is tag-oriented rather than a full text search", "Read the article before making a detailed claim"]
    },
    {
      "id": "wikipedia-api",
      "display_name": "MediaWiki Search API",
      "kind": "public-http-api",
      "source": "https://www.mediawiki.org/wiki/API:Search",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["wikipedia"],
      "providers": ["wikipedia"],
      "output": ["title", "url", "excerpt"],
      "limits": ["Use the article page for factual support; search snippets are discovery evidence"]
    },
    {
      "id": "openalex-api",
      "display_name": "OpenAlex Works API",
      "kind": "public-http-api",
      "source": "https://help.openalex.org/api/",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["academic", "google-scholar"],
      "providers": ["openalex"],
      "output": ["title", "url", "authors", "venue", "published_at", "citation_count", "search_metadata"],
      "limits": ["Configured OPENALEX_API_KEY is optional and sent in the Authorization header","One requested page per call, up to 100 records; source-reported totals and request metadata are preserved","Anonymous and authenticated API budgets apply; access can return 429","Query totals do not establish literature coverage or novelty","Metadata and citation counts do not replace paper body evidence","Cursor retrieval uses --cursor; current official policy requires a key to follow next_cursor beyond cursor=*."]
    },
    {
      "id": "arxiv-api",
      "display_name": "arXiv Atom API",
      "kind": "public-http-api",
      "source": "https://info.arxiv.org/help/api/index.html",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["academic", "google-scholar"],
      "providers": ["arxiv"],
      "output": ["title", "url", "summary", "published_at"],
      "limits": ["Use a polite request interval","Abstracts locate papers; detailed claims require the PDF or source body","--page maps to start; submission-date scope, totalResults and updated_at are retained."]
    },
    {
      "id": "google-scholar-html",
      "display_name": "Google Scholar public HTML discovery",
      "kind": "local-html-adapter",
      "source": "local:scripts/fast_search.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["google-scholar"],
      "providers": ["google-scholar"],
      "output": ["title", "authors", "published_at", "citation_count", "version_count", "pdf_url", "abstract_status", "retrieval_stage"],
      "limits": ["Direct public HTML has no official API guarantee","Result text is an abstract-like snippet and may be incomplete","Use low-frequency bounded requests and stop on 403, 429, CAPTCHA, or challenge pages","Enrich selected papers through OpenAlex, arXiv, Crossref, or the publisher before evidence work","Retain the entire ten-item returned page, including candidates beyond --limit; record the unconfirmed continuation and year/language scope."]
    },
    {
      "id": "crossref-api",
      "display_name": "Crossref Works API",
      "kind": "public-http-api",
      "source": "https://api.crossref.org/",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["academic", "google-scholar"],
      "providers": ["crossref"],
      "output": ["title", "doi", "authors", "published_at", "url"],
      "limits": ["Crossref confirms metadata, not the paper's findings","--page maps to offset; --cursor supports deeper queries; publication-date filters and source totals retained."]
    },
    {
      "id": "semantic-scholar-api",
      "display_name": "Semantic Scholar Graph API",
      "kind": "public-http-api",
      "source": "https://api.semanticscholar.org/api-docs/",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["academic", "google-scholar"],
      "providers": ["semantic-scholar"],
      "output": ["title", "url", "published_at", "authors", "doi", "paper_id", "citation_count", "abstract", "pdf_url", "search_metadata"],
      "limits": ["SEMANTIC_SCHOLAR_API_KEY is optional; anonymous calls share a rate-limit pool","Relevance search exposes at most 1,000 ranked matches; --paper-id with --relation references or citations reads the corresponding paginated edges","Abstracts may be unavailable; citation counts are source-specific","Use as a complement selected for the research question","--bulk preserves the whole server batch and --token continues it; relevance/edges use --offset."]
    },
    {
      "id": "pubmed-api",
      "display_name": "PubMed E-utilities",
      "kind": "public-http-api",
      "source": "https://www.ncbi.nlm.nih.gov/books/NBK25497/",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["academic", "google-scholar"],
      "providers": ["pubmed"],
      "output": ["title", "url", "published_at", "authors", "venue", "doi", "pmid", "abstract", "pmc_url", "search_metadata"],
      "limits": ["NCBI_API_KEY is optional; E-utilities rate limits apply", "ESearch discovers one page and EFetch retrieves those records' metadata and available abstracts", "PubMed metadata and abstracts do not imply full-text access"]
    },
    {
      "id": "serpapi-scholar-api",
      "display_name": "SerpApi Google Scholar",
      "kind": "public-http-api",
      "source": "https://serpapi.com/google-scholar-api",
      "requires_api_key": true,
      "status": "local-included-optional-credentials",
      "platforms": ["academic", "google-scholar"],
      "providers": ["serpapi-scholar"],
      "output": ["title", "url", "published_at", "authors", "publication_info", "citation_count", "version_count", "pdf_url", "abstract_status", "search_metadata"],
      "limits": ["Requires SERPAPI_API_KEY; uses that account's allowance only when this provider is selected", "Third-party Scholar results, not an official Google Scholar API", "One page per request, up to 20 records; totals are estimates and snippets are not full abstracts", "Keep the existing public google-scholar provider available; no automatic paid fallback"]
    },
    {
      "id": "rss-atom",
      "display_name": "RSS and Atom public feeds",
      "kind": "public-feed",
      "source": "local:scripts/fast_search.py",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["52pojie", "bbc", "youtube", "medium", "substack", "yahoo-finance", "academic"],
      "providers": ["rss"],
      "output": ["title", "url", "excerpt", "published_at"],
      "limits": ["A feed covers only the publisher's exposed entries", "Feed entries are discovery evidence until the source is read"]
    },
    {
      "id": "discourse-json",
      "display_name": "Discourse public JSON",
      "kind": "local-protocol-adapter",
      "source": "local:scripts/discourse_search.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["discourse", "rust-users", "kubernetes-discuss", "docker-community", "nixos-discourse", "home-assistant-community"],
      "providers": ["discourse"],
      "output": ["title", "url", "author", "created_at", "excerpt", "topic_id"],
      "limits": ["The forum must expose public Discourse JSON", "Each site must be verified independently"]
    },
    {
      "id": "52pojie-public",
      "display_name": "52pojie public reader",
      "kind": "local-skill-and-script",
      "source": "local:references/local/52pojie-research/scripts/fetch.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["52pojie"],
      "providers": ["52pojie"],
      "output": ["title", "url", "thread_id", "matched_in", "body", "replies"],
      "limits": ["Public listings, RSS, hot guide, and thread pages only", "No login, internal search, member pages, redirects, or attachments"]
    },
    {
      "id": "trafilatura",
      "display_name": "Trafilatura正文提取",
      "kind": "optional-python-package",
      "source": "https://pypi.org/project/trafilatura/",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["github", "academic", "google-scholar", "stackoverflow", "discourse", "bbc", "medium", "substack"],
      "providers": ["extract"],
      "output": ["title", "text", "date", "author"],
      "limits": ["It reads a selected URL and does not perform search", "Keep extraction after Top-K selection to control context size"]
    },
    {
      "id": "readability-lxml",
      "display_name": "Readability HTML extractor",
      "kind": "optional-python-package",
      "source": "https://pypi.org/project/readability-lxml/",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["github", "academic", "stackoverflow", "discourse", "bbc", "medium", "substack"],
      "providers": ["extract"],
      "output": ["title", "html"],
      "limits": ["Use as a fallback when the primary extractor fails", "It does not perform search"]
    },
    {
      "id": "dblp-api",
      "display_name": "DBLP publications and conference volumes",
      "kind": "public-http-api",
      "source": "https://dblp.org/faq/How+to+use+the+dblp+search+API.html",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": [
        "academic",
        "google-scholar"
      ],
      "providers": [
        "dblp"
      ],
      "output": [
        "title",
        "authors",
        "year",
        "venue",
        "doi",
        "dblp_key",
        "official_page",
        "search_metadata"
      ],
      "limits": [
        "h/f paginate publication search; --venue-url enumerates the chosen public volume XML",
        "Bibliographic coverage only, no abstract/full-text claim",
        "Stop on access/challenge responses; do not bypass or silently retry"
      ]
    }
  ]
}
