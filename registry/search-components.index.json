{
  "version": 1,
  "policy": {
    "default_auth": "none",
    "default_output": "compact-json",
    "default_evidence_level": "discovery",
    "raw_pages": "read-only-after-selection"
  },
  "components": [
    {
      "id": "fast-search",
      "display_name": "Fast Search public adapters",
      "kind": "local-script",
      "source": "local:scripts/fast_search.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["github", "stackoverflow", "hacker-news", "dev-to", "wikipedia", "academic", "discourse"],
      "providers": ["github", "stackoverflow", "hacker-news", "dev-to", "wikipedia", "openalex", "crossref", "arxiv", "discourse", "rss"],
      "output": ["title", "url", "published_at", "excerpt", "source", "match_reason", "evidence_level"],
      "limits": ["Public endpoints can rate-limit or change without notice", "Results are discovery evidence until the selected source is read"]
    },
    {
      "id": "ddgs",
      "display_name": "DuckDuckGo Search Python package",
      "kind": "optional-python-package",
      "source": "https://pypi.org/project/ddgs/",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["bilibili", "douyin", "tiktok", "xiaohongshu", "reddit", "zhihu", "bbc", "twitter-x", "youtube", "weibo", "douban", "medium", "substack", "linkedin", "yahoo-finance", "google"],
      "providers": ["ddgs"],
      "output": ["title", "url", "excerpt", "date"],
      "limits": ["Requires the optional ddgs package", "Underlying engines may vary in availability and ranking", "Use for discovery rather than source-level claims"]
    },
    {
      "id": "searxng-json",
      "display_name": "SearXNG JSON search",
      "kind": "public-http-api",
      "source": "https://docs.searxng.org/dev/search_api.html",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["google", "hacker-news", "dev-to", "lobsters", "reddit", "zhihu", "bbc", "twitter-x", "youtube", "weibo", "douban", "medium", "substack", "linkedin", "yahoo-finance"],
      "providers": ["searxng"],
      "output": ["title", "url", "excerpt", "engine"],
      "limits": ["A public instance must allow JSON output", "Instance latency, certificate state, and rate limits vary", "Do not treat one public instance as a stable dependency"]
    },
    {
      "id": "github-search-api",
      "display_name": "GitHub REST Search API",
      "kind": "public-http-api",
      "source": "https://docs.github.com/en/rest/search/search",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["github"],
      "providers": ["github"],
      "output": ["repository", "url", "description", "updated_at", "stars"],
      "limits": ["Anonymous search is rate limited", "Source claims still require repository tree and file reading"]
    },
    {
      "id": "stackexchange-api",
      "display_name": "Stack Exchange API",
      "kind": "public-http-api",
      "source": "https://api.stackexchange.com/docs/search-advanced",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["stackoverflow"],
      "providers": ["stackoverflow"],
      "output": ["title", "url", "tags", "answer_count", "is_answered", "last_activity"],
      "limits": ["Respect quota and backoff fields", "Answers remain community evidence and need context reading"]
    },
    {
      "id": "hn-algolia",
      "display_name": "Hacker News Algolia API",
      "kind": "public-http-api",
      "source": "https://hn.algolia.com/api",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["hacker-news"],
      "providers": ["hacker-news"],
      "output": ["title", "url", "excerpt", "created_at"],
      "limits": ["Search results are discovery evidence; read the linked story or thread for claims"]
    },
    {
      "id": "devto-api",
      "display_name": "Dev.to / Forem API",
      "kind": "public-http-api",
      "source": "https://developers.forem.com/api",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["dev-to"],
      "providers": ["dev-to"],
      "output": ["title", "url", "description", "published_at"],
      "limits": ["The public endpoint is tag-oriented rather than a full text search", "Read the article before making a detailed claim"]
    },
    {
      "id": "wikipedia-api",
      "display_name": "MediaWiki Search API",
      "kind": "public-http-api",
      "source": "https://www.mediawiki.org/wiki/API:Search",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["wikipedia"],
      "providers": ["wikipedia"],
      "output": ["title", "url", "excerpt"],
      "limits": ["Use the article page for factual support; search snippets are discovery evidence"]
    },
    {
      "id": "openalex-api",
      "display_name": "OpenAlex Works API",
      "kind": "public-http-api",
      "source": "https://docs.openalex.org/api-entities/works",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["academic"],
      "providers": ["openalex"],
      "output": ["title", "url", "authors", "venue", "publication_date", "cited_by_count"],
      "limits": ["Public access can return 429", "Metadata and citation counts do not replace paper body evidence"]
    },
    {
      "id": "arxiv-api",
      "display_name": "arXiv Atom API",
      "kind": "public-http-api",
      "source": "https://info.arxiv.org/help/api/index.html",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["academic"],
      "providers": ["arxiv"],
      "output": ["title", "url", "summary", "published_at"],
      "limits": ["Use a polite request interval", "Abstracts locate papers; detailed claims require the PDF or source body"]
    },
    {
      "id": "crossref-api",
      "display_name": "Crossref Works API",
      "kind": "public-http-api",
      "source": "https://api.crossref.org/",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["academic"],
      "providers": ["crossref"],
      "output": ["title", "doi", "authors", "published_at", "url"],
      "limits": ["Crossref confirms metadata, not the paper's findings"]
    },
    {
      "id": "semantic-scholar-api",
      "display_name": "Semantic Scholar Graph API",
      "kind": "public-http-api",
      "source": "https://api.semanticscholar.org/api-docs/",
      "requires_api_key": false,
      "status": "candidate-no-key-rate-limited",
      "platforms": ["academic"],
      "providers": ["semantic-scholar"],
      "output": ["title", "url", "year", "citations", "references"],
      "limits": ["No-key access can return 429", "Use as a supplement, not the only academic source"]
    },
    {
      "id": "rss-atom",
      "display_name": "RSS and Atom public feeds",
      "kind": "public-feed",
      "source": "local:scripts/fast_search.py",
      "requires_api_key": false,
      "status": "local-included-via-fast-search",
      "platforms": ["52pojie", "bbc", "youtube", "medium", "substack", "yahoo-finance", "academic"],
      "providers": ["rss"],
      "output": ["title", "url", "excerpt", "published_at"],
      "limits": ["A feed covers only the publisher's exposed entries", "Feed entries are discovery evidence until the source is read"]
    },
    {
      "id": "discourse-json",
      "display_name": "Discourse public JSON",
      "kind": "local-protocol-adapter",
      "source": "local:scripts/discourse_search.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["discourse", "rust-users", "kubernetes-discuss", "docker-community", "nixos-discourse", "home-assistant-community"],
      "providers": ["discourse"],
      "output": ["title", "url", "author", "created_at", "excerpt", "topic_id"],
      "limits": ["The forum must expose public Discourse JSON", "Each site must be verified independently"]
    },
    {
      "id": "52pojie-public",
      "display_name": "52pojie public reader",
      "kind": "local-skill-and-script",
      "source": "local:references/local/52pojie-research/scripts/fetch.py",
      "requires_api_key": false,
      "status": "local-included",
      "platforms": ["52pojie"],
      "providers": ["52pojie"],
      "output": ["title", "url", "thread_id", "matched_in", "body", "replies"],
      "limits": ["Public listings, RSS, hot guide, and thread pages only", "No login, internal search, member pages, redirects, or attachments"]
    },
    {
      "id": "trafilatura",
      "display_name": "Trafilatura正文提取",
      "kind": "optional-python-package",
      "source": "https://pypi.org/project/trafilatura/",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["github", "academic", "stackoverflow", "discourse", "bbc", "medium", "substack"],
      "providers": ["extract"],
      "output": ["title", "text", "date", "author"],
      "limits": ["It reads a selected URL and does not perform search", "Keep extraction after Top-K selection to control context size"]
    },
    {
      "id": "readability-lxml",
      "display_name": "Readability HTML extractor",
      "kind": "optional-python-package",
      "source": "https://pypi.org/project/readability-lxml/",
      "requires_api_key": false,
      "status": "candidate-no-key",
      "platforms": ["github", "academic", "stackoverflow", "discourse", "bbc", "medium", "substack"],
      "providers": ["extract"],
      "output": ["title", "html"],
      "limits": ["Use as a fallback when the primary extractor fails", "It does not perform search"]
    }
  ]
}
