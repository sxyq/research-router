      {"id": "javascript-runtime", "commands": ["deno", "node"]}
    ],
    "capabilities_require_live_test": ["search", "metadata", "subtitle"]
  },
  "script_note": "Bundled generic discovery finds public video URLs; yt-dlp is optional for search, metadata, and available subtitles. Do not start transcription implicitly.",
  "capabilities": ["search", "metadata", "subtitle when available", "video detail"],
  "depth_routes": {
    "light": ["generic-platform-discovery"],
    "medium": ["generic-platform-discovery"],
    "deep": ["generic-platform-discovery"]
  },
