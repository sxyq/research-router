  "scripts": ["scripts/platform_discovery.py", "scripts/probe_runtime.py"],
  "search_components": ["generic-public-site-discovery", "youtube-yt-dlp"],
  "adapter_type": "generic-site-discovery-plus-optional-cli",
  "access_mode": "public-generic-discovery; rich-video-runtime-optional",
