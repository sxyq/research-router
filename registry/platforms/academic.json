{
  "platform_id": "academic",
  "display_name": "论文与学术",
  "aliases": ["论文", "学术", "文献", "arxiv"],
  "capabilities": ["paper discovery", "author and venue lookup", "full-text retrieval", "citation evidence"],
  "depth_routes": {
    "light": ["autocli"],
    "medium": ["anysearch", "paper-research-router"],
    "deep": ["anysearch", "paper-research-router", "academic-evidence"]
  },
  "source_requirement": "A claim-support check requires the primary paper body or PDF, not title or abstract alone.",
  "agent_rule": "One academic Agent runs discovery first, then the Router explicitly calls academic-evidence when the evidence requirement needs it.",
  "post_discovery": {
    "when": ["claim support", "PDF body text", "citation audit", "evidence table", "local PDFs", "normalized citation metadata"],
    "append": ["academic-evidence"],
    "stage": "evidence-processing"
  }
}
