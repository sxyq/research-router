{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sxyq/research-router/schema/feedback-record.schema.json",
  "title": "Research Router Feedback Record",
  "type": "object",
  "required": ["feedback_id", "route_id", "created_at", "target_skill_id", "score"],
  "properties": {
    "feedback_id": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "target_skill_id": {"type": "string", "minLength": 1},
    "score": {"type": "number", "minimum": 0, "maximum": 10},
    "comment": {"type": "string"},
    "route_change_suggestion": {"type": "string"}
  }
}
