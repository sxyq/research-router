{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sxyq/research-router/schema/experience-record.schema.json",
  "title": "Research Router Experience Record",
  "type": "object",
  "required": ["experience_id", "recorded_at", "route_id", "subject_type", "subject_id", "scene", "depth", "selected", "executed", "outcome", "source_coverage", "route_evaluation", "failures", "stop_reason"],
  "properties": {
    "experience_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "route_id": {"type": "string", "minLength": 1},
    "subject_type": {"enum": ["skill", "platform"]},
    "subject_id": {"type": "string", "minLength": 1},
    "scene": {"enum": ["bug-fix", "open-source", "academic", "community"]},
    "depth": {"enum": ["light", "medium", "deep"]},
    "requirement": {"$ref": "#/$defs/requirement"},
    "selected": {"type": "boolean"},
    "executed": {"type": "boolean"},
    "outcome": {"enum": ["planned", "running", "completed", "partial", "failed"]},
    "platform_ids": {"type": "array", "items": {"type": "string"}},
    "skill_ids": {"type": "array", "items": {"type": "string"}},
    "skill_order": {"type": "array", "items": {"type": "string"}},
    "platform_queries": {"type": "array", "items": {"type": "string"}},
    "query_variants": {"type": "array", "items": {"type": "string"}},
    "source_coverage": {"$ref": "#/$defs/sourceCoverage"},
    "route_evaluation": {"$ref": "#/$defs/routeEvaluation"},
    "failures": {"type": "array"},
    "stop_reason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["target", "goal", "capabilities", "context", "constraints", "evidence", "time", "explicit_platforms"],
      "properties": {
        "target": {"type": "string"},
        "goal": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "context": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "time": {"type": "array", "items": {"type": "string"}},
        "explicit_platforms": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sourceCoverage": {
      "type": "object",
      "required": ["status", "requested", "covered", "missing"],
      "properties": {
        "status": {"enum": ["verified", "partial", "unavailable"]},
        "requested": {"type": "array", "items": {"type": "string"}},
        "covered": {"type": "array", "items": {"type": "string"}},
        "missing": {"type": "array", "items": {"type": "string"}},
        "source_count": {"type": "integer", "minimum": 0},
        "direct_source_count": {"type": "integer", "minimum": 0},
        "recency_score": {"type": ["number", "null"], "minimum": 0, "maximum": 10}
      }
    },
    "routeEvaluation": {
      "type": "object",
      "required": ["problem_coverage", "evidence_directness", "recency", "deduplication", "execution_cost", "unconfirmed_items", "overall", "method"],
      "properties": {
        "problem_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "evidence_directness": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "recency": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "deduplication": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "execution_cost": {"type": "object"},
        "unconfirmed_items": {"type": "array", "items": {"type": "string"}},
        "overall": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
        "method": {"enum": ["manual", "heuristic", "combined"]}
      }
    }
  }
}
