{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Router Skill Entry",
  "type": "object",
  "required": ["id", "display_name", "role", "kind", "source", "platforms", "status"],
  "properties": {
    "id": {"type": "string"},
    "display_name": {"type": "string"},
    "role": {"type": "string"},
    "kind": {"type": "string"},
    "source": {"type": "string"},
    "load": {"enum": ["on-demand"]},
    "platforms": {"type": "array", "items": {"type": "string"}},
    "router_platforms": {"type": "array", "items": {"type": "string"}},
    "catalog_only_platforms": {"type": "array", "items": {"type": "string"}},
    "tier": {"type": "integer", "minimum": 1, "maximum": 3},
    "adapter_type": {"type": "string"},
    "scripts": {"type": "array", "items": {"type": "string"}},
    "coverage_note": {"type": "string"},
    "limits": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string"}
  }
}
